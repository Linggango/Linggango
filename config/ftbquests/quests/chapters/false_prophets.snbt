			]
			shape: "netheritetier"
			size: 1.5d
			subtitle: "The Silent Cataclysm"
			tasks: [{
				entity: "macabre:baal"
				icon: "macabre:baal_heart"
				id: "49B03FBFDE364957"
				title: "Slay &cBaal, the Motionless Calamity"
				type: "kill"
				value: 1L
			}]
			x: 7.4357142857142335d
			y: -3.2309523809523952d
		}
		{
			dependencies: ["5638CED77424242D"]
			description: [
				"&4Torso upon torso, mouth upon mouth—Gomoria speaks in languages that predate creation. His prayers are blasphemies that make reality recoil. Each whispered word carries the weight of cosmic heresy. Go, and silence his unholy liturgy. From his stilled heart, new power awaits."
				"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:500 height:15 align:center}"
				"&oGo shut his prayers :3"
			]
			icon_scale: 1.2d
			id: "7447249A0F85D8BA"
			min_width: 500
			rewards: [
				{
					id: "4D958BB025478D09"
					table_id: 8699295573854160387L
					title: "&l&4Glorious"
					type: "random"
				}
				{
					id: "650D397AD80B2B59"
					type: "xp"
					xp: 500
				}
			]
			shape: "netheritetier"
			size: 1.5d
			subtitle: "Whisperer of Bone and Flesh"
			tasks: [{
				entity: "macabre:gomoria"
				icon: "macabre:gomoria_heart"
				id: "67892F4DB26A93E5"
				title: "Slay &cGomoria, the Fleshmonger Monk"
				type: "kill"
				value: 1L
			}]
			x: 4.297619047618994d
			y: -2.730952380952381d
		}
		{
			dependencies: ["1C4A7CC605B59DF7"]
			description: ["&4A cathedral of scars made flesh, Valamon's body weeps eternal tears of crimson. Each joint tells a story of torment, every seam a testament to unholy resurrection. His form is assembled from countless souls—and he hungers for one more. When his stitched form finally falls, his butcher's heart will be yours to claim."]
			icon_scale: 1.2d
			id: "5638CED77424242D"
			min_width: 500
			rewards: [
				{
					id: "2786BE81911BAF4F"
