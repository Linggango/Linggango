					title: "&l&4Glorious"
					type: "random"
				}
				{
					id: "7F1030F8D683CDF9"
					type: "xp"
					xp: 500
				}
			]
			shape: "netheritetier"
			size: 1.5d
			subtitle: "Harbinger of the Scars"
			tasks: [{
				entity: "macabre:valamon"
				icon: "macabre:valamon_heart"
				id: "44A7EBE249543A76"
				title: "Slay &cValamon, The Corpse Butcher"
				type: "kill"
				value: 1L
			}]
			x: 0.9404761904761543d
			y: -2.073809523809537d
		}
		{
			dependencies: ["1A3D29373F2D26AA"]
			description: [
				"&4Gargamaw transcends mere monstrosity—he is appetite given form, gluttony carved from nightmares. His maw devours not just flesh but hope itself. This calamitous monument to consumption awaits those foolish enough to approach his throne of bones. His massive heart, when finally stilled, pulses with the power of endless hunger."
				"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:500 height:15 align:center}"
				"&oIt is a calamity given form, a gluttonous monument."
			]
			icon_scale: 1.3d
			id: "2129027DAA1584A2"
			min_width: 500
			rewards: [
				{
					id: "62A485A88A545A92"
