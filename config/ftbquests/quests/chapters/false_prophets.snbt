	quest_links: [ ]
	quests: [
		{
			dependencies: ["7447249A0F85D8BA"]
			description: ["&4From stillness comes devastation. Baal's portal births colossal arms of pure malice, each strike reshaping the very ground beneath your feet. Motionless yet omnipresent, he embodies the paradox of unstoppable force meeting immovable object. Even in death, his heart pounds with calamitous energy."]
			icon_scale: 1.2d
			id: "1A3D29373F2D26AA"
			min_width: 500
			rewards: [
				{
