			]
			shape: "netheritetier"
			size: 1.5d
			subtitle: "The Prism of Shadows"
			tasks: [{
				entity: "macabre:morphegor_split"
				icon: "macabre:morphegor_heart"
				id: "344BD329A03188F8"
				title: "Slay &cMorphegor, The Split Deceiver"
				type: "kill"
				value: 1L
			}]
			x: 2.9119047619047294d
			y: 1.0047619047618923d
		}
		{
			dependencies: ["218A1EC80DE60194"]
			description: [
				"&4Forged in whispers of damnation and quenched in the marrow of the forgotten, this dirk is no mere weapon—it is a key carved in blood. Its jagged edge thirsts for the living. Four cuts upon your flesh, four offerings to the void. With each slice, reality grows thinner, and the voices grow louder. On the final cut, your very essence crystallizes into a key that will rupture reality itself. "
				"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:200 height:15 align:center}"
				"&4To carry it is to carry blasphemy itself. To use it… is to be damned forever."
				""
				"&8Credits: l1badu (improved the quest thanks to him :D)"
			]
			icon: "macabre:sacrificial_dirk"
			id: "155C2CD942825FCC"
			rewards: [{
				id: "67D6745CDE00BF2F"
				type: "xp"
				xp: 500
			}]
			shape: "netheritetier"
			size: 1.5d
			subtitle: "Use the Sacrificial Dirk 4 times to obtain Crystallized Blood "
			tasks: [{
				id: "49EB506A5458292C"
				item: "macabre:sacrificial_dirk"
				type: "item"
			}]
			title: "&4The Sacrificial Blade"
			x: -2.5d
			y: 6.376190476190473d
		}
		{
			dependencies: ["155C2CD942825FCC"]
			description: [
				"&4Born from your offering, every fragment carries the screams of those who abandoned God's light. To hold it is to hear echoes of the damned. Use it now—rupture reality itself and step into the realm where False Prophets writhe and rule. "
				"{image:fzzy_config:textures/gui/sprites/widget/popup/divider.png width:500 height:15 align:center}"
				"&4&oTo hold it is to hear echoes of the damned. To use it is to rupture reality itself—splitting open the threshold and dragging you into &4The Pit,&r &4where the False Prophets writhe and rule."
			]
			id: "4807DF76B710A9A7"
			min_width: 500
			rewards: [{
				id: "275E76DCAFFCBD02"
				type: "xp"
				xp: 500
			}]
			shape: "netheritetier"
			subtitle: "Use Crystallized Blood to enter The Pit"
			tasks: [{
				id: "5820C83835C62509"
				item: {
					Count: 1
